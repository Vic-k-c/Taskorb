<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Team - TaskOrb</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="has-bottom-nav">
  <%- include('partials/nav', { active: 'users', currentUser }) %>
  <div class="page">
    <h1>Team</h1>
    <p style="font-size:13px; color:var(--text-muted); margin-top:-8px;">Members of this organization only. Switch orgs from the menu next to the logo to manage a different team.</p>

    <div class="card-panel" style="margin-bottom:20px;">
      <table class="simple">
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th></th></tr></thead>
        <tbody>
          <% users.forEach(function(u) { %>
            <tr>
              <td><%= u.name %></td>
              <td><%= u.email %></td>
              <td style="text-transform:capitalize;"><%= u.role %></td>
              <td>
                <% if (u.id !== currentUser.id) { %>
                  <form method="POST" action="/users/<%= u.id %>?_method=DELETE" onsubmit="return confirm('Remove this person from the organization? Their account and any other orgs they belong to are unaffected.');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn danger small">Remove</button>
                  </form>
                <% } else { %>
                  <span style="font-size:12px; color:var(--text-muted);">You</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="card-panel" style="max-width:460px;">
      <h3>Add a team member</h3>
      <div style="display:flex; gap:8px; margin-bottom:14px;">
        <button type="button" class="btn small" id="tabInvite" onclick="setAddMode('invite')">Invite existing account</button>
        <button type="button" class="btn ghost small" id="tabCreate" onclick="setAddMode('create')">Create new account</button>
      </div>
      <% if (error) { %><div class="error-box"><%= error %></div><% } %>

      <form method="POST" action="/users">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="mode" id="addMode" value="invite">

        <div id="inviteFields">
          <p style="font-size:12px; color:var(--text-muted); margin:0 0 10px;">
            They need a TaskOrb account already (any org's — accounts are self-service). If they don't have one yet, either send them to <code>/register</code>, or use "Create new account" instead.
          </p>
          <label>Their email</label>
          <input type="email" name="email" id="inviteEmail" placeholder="person@example.com">
        </div>

        <div id="createFields" style="display:none;">
          <p style="font-size:12px; color:var(--text-muted); margin:0 0 10px;">
            Creates a brand new account and sets its password directly — useful for people who won't sign themselves up. Share the password with them separately; they can change it from Account settings anytime.
          </p>
          <label>Full name</label>
          <input type="text" name="name" id="createName" placeholder="Jane Smith">
          <label>Email</label>
          <input type="email" name="email" id="createEmail" placeholder="person@example.com">
          <label>Initial password</label>
          <input type="password" name="password" id="createPassword" placeholder="6+ characters" minlength="6">
        </div>

        <label>Role in this org</label>
        <select name="role">
          <option value="member">Member — adds &amp; works cards</option>
          <option value="leader">Leader — also assigns &amp; exports</option>
          <option value="admin">Admin — full access, manages team</option>
        </select>
        <button type="submit" class="btn">Add member</button>
      </form>
    </div>
  </div>

  <script>
    function setAddMode(mode) {
      document.getElementById('addMode').value = mode;
      const isInvite = mode === 'invite';
      document.getElementById('inviteFields').style.display = isInvite ? '' : 'none';
      document.getElementById('createFields').style.display = isInvite ? 'none' : '';
      document.getElementById('tabInvite').className = isInvite ? 'btn small' : 'btn ghost small';
      document.getElementById('tabCreate').className = isInvite ? 'btn ghost small' : 'btn small';
      // Disabled inputs are excluded from form submission entirely -- this
      // both enforces which fields are required AND stops the two email
      // inputs (invite vs create) from colliding under the same field name.
      document.getElementById('inviteEmail').disabled = !isInvite;
      document.getElementById('inviteEmail').required = isInvite;
      document.getElementById('createName').disabled = isInvite;
      document.getElementById('createName').required = !isInvite;
      document.getElementById('createEmail').disabled = isInvite;
      document.getElementById('createEmail').required = !isInvite;
      document.getElementById('createPassword').disabled = isInvite;
      document.getElementById('createPassword').required = !isInvite;
    }
    setAddMode('invite');
  </script>
</body>
</html>
