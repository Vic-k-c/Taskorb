<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#17233A">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="TaskOrb">
  <title>Calendar - TaskOrb</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/calendar.css">
</head>
<body class="has-bottom-nav">
  <%- include('partials/nav', { active: 'calendar', currentUser }) %>
  <div class="page">
    <div class="cal-title-row">
      <div>
        <h1>Calendar</h1>
        <p style="font-size:13px; color:var(--text-muted); margin-top:-8px;">Everything with a date across your boards: due dates, follow-ups, visits. Click any entry to open it on its board.</p>
      </div>
      <div class="cal-filter" role="group" aria-label="Whose follow-ups to show">
        <button type="button" class="active" data-filter="all">Everyone</button>
        <button type="button" data-filter="mine">Only mine</button>
      </div>
    </div>

    <div class="card-panel push-panel" id="pushPanel">
      <div id="pushText">Checking notification settings&hellip;</div>
      <div class="push-actions" id="pushActions"></div>
    </div>

    <div class="card-panel">
      <div class="cal-toolbar">
        <h3 id="calMonthTitle" style="margin:0;"></h3>
        <div class="cal-nav">
          <button type="button" class="btn ghost small" id="calPrev" aria-label="Previous month">&lsaquo;</button>
          <button type="button" class="btn ghost small" id="calToday">Today</button>
          <button type="button" class="btn ghost small" id="calNext" aria-label="Next month">&rsaquo;</button>
        </div>
      </div>
      <div class="cal-grid" id="calGrid" role="grid"></div>
    </div>

    <div class="card-panel">
      <h3 id="dayTitle" style="margin-top:0;"></h3>
      <div id="dayList"></div>
    </div>

    <div class="card-panel">
      <h3 style="margin-top:0;">Coming up</h3>
      <div id="upcomingList"></div>
    </div>
  </div>

  <script>
    window.FOLLOWUPS = <%- JSON.stringify(followUps).replace(/</g, '\\u003c') %>;
    window.ME_ID = <%= meId %>;
  </script>
  <script src="/js/calendar.js"></script>
</body>
</html>
