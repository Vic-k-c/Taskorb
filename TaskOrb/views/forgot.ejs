<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#17233A">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="TaskOrb">
  <title>Forgot password - TaskOrb</title>
  <link rel="icon" href="/img/logo.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-box">
      <img src="/img/logo.png" alt="TaskOrb" class="logo-img" style="height:36px; margin-bottom:8px;">
      <h1 style="font-size:20px;">Forgot your password?</h1>
      <% if (sent) { %>
        <p class="sub">If that email has a TaskOrb account, a reset link is on its way. It's valid for 1 hour. Check your spam folder too.</p>
        <div class="switch"><a href="/login">Back to log in</a></div>
      <% } else { %>
        <p class="sub">Enter your account email and we'll send you a link to choose a new password.</p>
        <% if (error) { %><div class="error-box"><%= error %></div><% } %>
        <form method="POST" action="/forgot">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Email</label>
          <input type="email" name="email" required autofocus>
          <button class="btn" type="submit">Send reset link</button>
        </form>
        <div class="switch"><a href="/login">Back to log in</a></div>
      <% } %>
    </div>
  </div>
</body>
</html>
