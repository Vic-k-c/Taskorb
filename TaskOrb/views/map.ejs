<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#17233A">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="TaskOrb">
  <title>Map - TaskOrb</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="has-bottom-nav">
  <%- include('partials/nav', { active: 'map', currentUser }) %>
  <div class="map-wrap">
    <div class="map-hint" id="mapHint">Locating you&hellip;</div>
    <div id="map"></div>
  </div>

  <script>
    window.BOARDS_DATA = <%- JSON.stringify(boardsWithLists).replace(/</g, '\\u003c') %>;
    window.ORG_TAGS = <%- JSON.stringify(orgTags).replace(/</g, '\\u003c') %>;
    window.TEMPLATES = <%- JSON.stringify(templates).replace(/</g, '\\u003c') %>;
    window.DEFAULT_TEMPLATE = <%- JSON.stringify(currentUser.default_template || 'blank').replace(/</g, '\\u003c') %>;
  </script>
  <script src="/js/map.js" defer></script>
  <script src="https://maps.googleapis.com/maps/api/js?key=<%= googleMapsApiKey %>&callback=initTaskorbMap&loading=async&libraries=marker" defer></script>
</body>
</html>
