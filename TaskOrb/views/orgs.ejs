<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Your Organizations - TaskOrb</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-box" style="width:440px;">
      <img src="/img/logo.png" alt="TaskOrb" class="logo-img" style="height:32px; margin-bottom:8px;">
      <h1 style="font-size:20px;">Choose an organization</h1>
      <p class="sub">Pick which one to work in. You can switch anytime from the menu next to the logo.</p>
      <% if (error) { %><div class="error-box"><%= error %></div><% } %>

      <% if (orgs.length > 0) { %>
        <div style="margin: 14px 0;">
          <% orgs.forEach(function(o) { %>
            <div class="org-row" data-org-id="<%= o.id %>" style="border:1px solid var(--border); border-radius:8px; padding:8px 10px; margin-bottom:8px;">
              <div style="display:flex; align-items:center; justify-content:space-between; gap:8px; flex-wrap:wrap;">
                <button type="button" class="org-pick-btn" onclick="doSwitch(<%= o.id %>)">
                  <span><%= o.name %></span><span class="org-role-tag">(<%= o.role %>)</span>
                </button>
                <% if (o.role === 'admin') { %>
                  <button type="button" class="org-gear-btn" title="Organization settings" aria-label="Organization settings" onclick="toggleManage(<%= o.id %>)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06A1.65 1.65 0 004.6 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06A1.65 1.65 0 009 4.6a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
                  </button>
                <% } %>
              </div>
              <% if (o.role === 'admin') { %>
                <div class="org-manage-panel" id="manage-<%= o.id %>" style="display:none; margin-top:10px; padding-top:10px; border-top:1px solid var(--border);">
                  <p style="margin:0 0 8px; font-size:12px; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.03em;">Organization settings</p>
                  <label style="margin-top:0;">Rename</label>
                  <div style="display:flex; gap:6px;">
                    <input type="text" id="rename-<%= o.id %>" value="<%= o.name %>" style="flex:1;">
                    <button type="button" class="btn small" onclick="doRename(<%= o.id %>)">Save</button>
                  </div>
                  <div class="danger-zone">
                    <h4>Danger zone</h4>
                    <button type="button" class="btn danger small" onclick="doDelete(<%= o.id %>, '<%= o.name.replace(/'/g, "\\'") %>')">Delete this organization</button>
                  </div>
                </div>
              <% } %>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p style="font-size:13px; color:var(--text-muted);">You're not part of any organization yet.</p>
      <% } %>

      <div style="border-top:1px solid var(--border); margin-top:14px; padding-top:14px;">
        <label>Create a new organization</label>
        <form method="POST" action="/orgs">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="text" name="name" placeholder="Organization name" required>
          <button type="submit" class="btn" style="margin-top:10px; width:100%;">Create</button>
        </form>
      </div>

      <div class="switch"><a href="/logout">Log out</a></div>
    </div>
  </div>

  <script>window.CSRF_TOKEN = <%- JSON.stringify(csrfToken) %>;</script>
  <script src="/js/csrf.js"></script>
  <script>
    function doSwitch(id) {
      fetch(`/orgs/switch/${id}`, { method: 'POST' })
        .then((r) => r.json().then((data) => ({ ok: r.ok, data })))
        .then(({ ok, data }) => { if (!ok) throw new Error(data.error); window.location.href = '/'; })
        .catch((err) => alert(err.message));
    }

    function toggleManage(id) {
      const panel = document.getElementById(`manage-${id}`);
      panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
    }

    function doRename(id) {
      const name = document.getElementById(`rename-${id}`).value;
      fetch(`/orgs/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name })
      })
        .then((r) => r.json().then((data) => ({ ok: r.ok, data })))
        .then(({ ok, data }) => { if (!ok) throw new Error(data.error); window.location.reload(); })
        .catch((err) => alert(err.message));
    }

    function doDelete(id, name) {
      const typed = prompt(`This permanently deletes "${name}" and everything in it -- boards, cards, attachments, all of it. Type DELETE to confirm.`);
      if (typed !== 'DELETE') return;
      fetch(`/orgs/${id}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ confirm: 'DELETE' })
      })
        .then((r) => r.json().then((data) => ({ ok: r.ok, data })))
        .then(({ ok, data }) => { if (!ok) throw new Error(data.error); window.location.reload(); })
        .catch((err) => alert(err.message));
    }
  </script>
</body>
</html>
