<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#17233A">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="TaskOrb">
  <title>Import from Bubble - Platform Admin - TaskOrb</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/billing.css">
</head>
<body class="has-bottom-nav">
  <%- include('partials/nav', { active: 'platform', currentUser }) %>
  <div class="page">
    <h1>Import preview</h1>
    <p style="font-size:13px; color:var(--text-muted); margin-top:-8px;"><a href="/platform/import">&larr; Back to uploads</a></p>
    <div class="stat-grid">
      <div class="stat-card"><div class="num"><%= plan.counts.orgs %></div><div class="label">Organisations</div></div>
      <div class="stat-card"><div class="num"><%= plan.counts.users %></div><div class="label">People</div></div>
      <div class="stat-card"><div class="num"><%= plan.counts.boards %></div><div class="label">Boards</div></div>
      <div class="stat-card"><div class="num"><%= plan.counts.lists %></div><div class="label">Lists</div></div>
      <div class="stat-card"><div class="num"><%= plan.counts.cards %></div><div class="label">Cards</div></div>
      <div class="stat-card"><div class="num"><%= plan.counts.pins %></div><div class="label">Map pins</div></div>
    </div>
    <div class="card-panel" style="margin-top:16px;">
      <h3>Files read</h3>
      <% batch.files.forEach(function(f) { %><div style="font-size:13px;"><strong><%= f.type %></strong>: <%= f.name %> (<%= f.rows %> rows)</div><% }); %>
      <p style="font-size:12px; color:var(--text-muted);">Every row of every file is kept in the database, including types TaskOrb has no screen for yet.</p>
    </div>
    <% if (plan.warnings.length) { %>
    <div class="card-panel" style="margin-top:16px;">
      <h3>Things to know</h3>
      <ul style="font-size:13px;"><% plan.warnings.forEach(function(w) { %><li><%= w %></li><% }); %></ul>
    </div>
    <% } %>
    <div class="card-panel" style="margin-top:16px;">
      <h3>What will be created</h3>
      <div class="table-scroll"><table class="simple">
        <thead><tr><th>Organisation</th><th>Admins</th><th>Board</th><th>Lists</th><th>Cards</th></tr></thead>
        <tbody>
        <% plan.orgs.forEach(function(o) { o.boards.forEach(function(b, i) { %>
          <tr>
            <td><%= i === 0 ? o.name : '' %></td>
            <td style="font-size:12px;"><%= i === 0 ? Array.from(o.admins).join(', ') : '' %></td>
            <td><%= b.title %></td>
            <td><%= b.lists.length %></td>
            <td><%= b.lists.reduce(function(n, l) { return n + l.cards.length; }, 0) %></td>
          </tr>
        <% }); }); %>
        </tbody>
      </table></div>
      <p style="font-size:12px; color:var(--text-muted);">
        People get new TaskOrb accounts if they don't have one (no password: send each a reset link from the platform page).
        Completed tasks get a "Done" tag. Past due dates are imported without sending reminders. Re-running never duplicates anything that was already imported.
      </p>
      <form method="POST" action="/platform/import/<%= batch.id %>/run" onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').textContent='Importing...';">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn" <%= batch.status === 'imported' ? 'disabled' : '' %>>Import now</button>
      </form>
    </div>
  </div>
</body>
</html>
