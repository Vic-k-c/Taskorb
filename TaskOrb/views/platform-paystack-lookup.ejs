<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Paystack Lookup - Platform Admin - TaskOrb</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/billing.css">
</head>
<body class="has-bottom-nav">
  <%- include('partials/nav', { active: 'platform', currentUser }) %>
  <div class="page">
    <h1>Paystack subscription lookup</h1>
    <p style="font-size:13px; color:var(--text-muted); margin-top:-8px;">
      Look up any email directly against live Paystack, and manually assign their subscription to their org.
      <a href="/platform">&larr; Back to platform overview</a>
    </p>

    <% if (locals.applied) { %>
      <div class="billing-banner success">Subscription assigned. The user was notified and will see a popup next time they load the app.</div>
    <% } %>
    <% if (locals.error) { %>
      <div class="billing-banner upgrade-reason"><%= error %></div>
    <% } %>

    <div class="card-panel">
      <form method="GET" action="/platform/paystack-lookup" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;">
        <div style="flex:1; min-width:220px;">
          <label style="margin-top:0;">Email to look up</label>
          <input type="email" name="email" value="<%= email %>" placeholder="person@example.com" required>
        </div>
        <button type="submit" class="btn" style="height:38px;">Look up</button>
      </form>
    </div>

    <% if (email && legacyMapEntries.length > 0) { %>
      <div class="card-panel">
        <h3 style="font-size:14px;">Currently configured legacy plan codes</h3>
        <table class="simple">
          <thead><tr><th>Paystack Plan Code</th><th>Maps to</th></tr></thead>
          <tbody>
            <% legacyMapEntries.forEach(function(entry) { %>
              <tr><td><code><%= entry[0] %></code></td><td><%= entry[1].planKey %> (<%= entry[1].cycle %>)</td></tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <% if (email && lookupError) { %>
      <div class="card-panel">
        <p style="color:var(--clay); font-size:13px;">Paystack lookup failed: <%= lookupError %></p>
      </div>
    <% } %>

    <% if (email && customer) { %>
      <div class="card-panel">
        <h3 style="font-size:14px;">Paystack customer: <%= customer.customer_code %></h3>
        <details style="margin-bottom:14px;">
          <summary style="cursor:pointer; font-size:12px; color:var(--text-muted);">Show raw Paystack response (for debugging field names)</summary>
          <pre style="font-size:11px; white-space:pre-wrap; word-break:break-all; background:#f4f3ee; padding:10px; border-radius:6px; max-height:400px; overflow:auto;"><%= JSON.stringify(customer, null, 2) %></pre>
        </details>
        <% var subs = customer.subscriptions || []; %>
        <% if (subs.length === 0) { %>
          <p style="font-size:13px; color:var(--text-muted);">No subscriptions found for this customer.</p>
        <% } else { %>
          <div class="table-scroll">
          <table class="simple">
            <thead><tr><th>Plan code</th><th>Status</th><th>Amount</th><th>Next payment</th><th>In our map?</th><th></th></tr></thead>
            <tbody>
              <% subs.forEach(function(sub) { %>
                <% var planCode = sub.plan && sub.plan.plan_code; %>
                <% var match = legacyMapEntries.find(function(e) { return e[0] === planCode; }); %>
                <tr>
                  <td><code><%= planCode %></code></td>
                  <td style="text-transform:capitalize;"><%= sub.status %></td>
                  <td><%= sub.amount ? (sub.amount/100) : '?' %> <%= sub.plan && sub.plan.currency %></td>
                  <td><%= sub.next_payment_date ? new Date(sub.next_payment_date).toLocaleDateString() : '-' %></td>
                  <td><%= match ? ('Yes \u2014 ' + match[1].planKey + ':' + match[1].cycle) : 'No' %></td>
                  <td>
                    <% if (orgOptions.length === 0) { %>
                      <span style="font-size:12px; color:var(--text-muted);">No TaskOrb account for this email yet</span>
                    <% } else if (orgOptions.length > 1 && !targetOrg) { %>
                      <span style="font-size:12px; color:var(--text-muted);">Belongs to multiple orgs \u2014 pick one below</span>
                    <% } else { %>
                      <% var org = targetOrg || orgOptions[0]; %>
                      <form method="POST" action="/platform/paystack-lookup/apply" style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="email" value="<%= email %>">
                        <input type="hidden" name="orgId" value="<%= org.id %>">
                        <input type="hidden" name="customerCode" value="<%= customer.customer_code %>">
                        <input type="hidden" name="subscriptionCode" value="<%= sub.subscription_code %>">
                        <input type="hidden" name="emailToken" value="<%= sub.email_token %>">
                        <input type="hidden" name="nextPaymentDate" value="<%= sub.next_payment_date %>">
                        <select name="planKey" style="width:auto; font-size:12px; padding:4px 6px;">
                          <% ['individual','team_starter','team','team_growth','team_business'].forEach(function(pk) { %>
                            <option value="<%= pk %>" <%= (match && match[1].planKey === pk) || (!match && pk === 'team') ? 'selected' : '' %>><%= pk %></option>
                          <% }); %>
                        </select>
                        <select name="cycle" style="width:auto; font-size:12px; padding:4px 6px;">
                          <option value="annual" <%= (match ? match[1].cycle === 'annual' : true) ? 'selected' : '' %>>annual</option>
                          <option value="monthly" <%= (match && match[1].cycle === 'monthly') ? 'selected' : '' %>>monthly</option>
                        </select>
                        <button type="submit" class="btn small" onclick="return confirm('Assign this subscription to ' + '<%= org.name %>' + '? Double-check the plan/cycle picked above match what they actually pay for Paystack.');">
                          Assign to <%= org.name %>
                        </button>
                      </form>
                      <p style="font-size:11px; color:var(--text-muted); margin:4px 0 0;">
                        Subscription code (<%= sub.subscription_code || 'missing!' %>) and email token are read directly from this row regardless of the plan-code match above \u2014 pick plan/cycle manually if "In our map?" says No.
                      </p>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
          </div>
        <% } %>
      </div>

      <% if (orgOptions.length > 1) { %>
        <div class="card-panel">
          <h3 style="font-size:14px;">This email belongs to multiple orgs</h3>
          <table class="simple">
            <thead><tr><th>Org</th><th>Role</th><th>Current plan</th></tr></thead>
            <tbody>
              <% orgOptions.forEach(function(o) { %>
                <tr><td><%= o.name %> (id <%= o.id %>)</td><td><%= o.role %></td><td><%= o.plan_key %></td></tr>
              <% }); %>
            </tbody>
          </table>
          <p style="font-size:12px; color:var(--text-muted);">Use the CLI script (db/migrate-subscription.js --org-id=&lt;id&gt;) to target a specific one of these precisely.</p>
        </div>
      <% } %>
    <% } %>
  </div>
</body>
</html>
