<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Plans &amp; pricing - TaskOrb</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/billing.css">
</head>
<body class="has-bottom-nav">
  <%- include('partials/nav', { active: 'billing', currentUser }) %>
  <div class="page">
    <h1>Plans &amp; pricing</h1>

    <% if (reasonMessage) { %>
      <div class="billing-banner upgrade-reason"><%= reasonMessage %> Pick a plan below to unlock it.</div>
    <% } %>
    <% if (!isAdmin) { %>
      <div class="billing-banner">Only an org admin can change the plan or make a payment. Ask an admin to upgrade this organization.</div>
    <% } %>

    <div class="cycle-toggle">
      <button type="button" class="cycle-btn active" data-cycle="monthly">Monthly</button>
      <button type="button" class="cycle-btn" data-cycle="annual">Annual <span class="save-badge">Save ~20%</span></button>
    </div>

    <div class="pricing-grid">
      <% plans.forEach(function(plan) { %>
        <div class="pricing-card <%= plan.key === currentPlanKey ? 'current' : '' %>">
          <h3><%= plan.name %></h3>
          <p class="pricing-tagline"><%= plan.tagline %></p>
          <div class="pricing-amount">
            <% if (plan.key === 'free') { %>
              <span class="amount">$0</span>
            <% } else { %>
              <span class="amount monthly-amount">$<%= plan.priceMonthly %></span><span class="amount annual-amount" style="display:none;">$<%= plan.priceAnnual %></span>
              <span class="per"><span class="monthly-per">/mo</span><span class="annual-per" style="display:none;">/yr</span></span>
            <% } %>
          </div>

          <ul class="pricing-features">
            <li><%= plan.seatLimit === null ? 'Unlimited seats' : plan.seatLimit + ' seat' + (plan.seatLimit === 1 ? '' : 's') %></li>
            <li><%= plan.boardLimit === null ? 'Unlimited boards' : plan.boardLimit + ' board' + (plan.boardLimit === 1 ? '' : 's') %></li>
            <li class="<%= plan.hasMap ? '' : 'muted' %>">Map / pins</li>
            <li class="<%= plan.hasExport ? '' : 'muted' %>">CSV / PDF export</li>
            <li class="<%= plan.hasOrgTags ? '' : 'muted' %>">Org-wide tags</li>
            <li class="<%= plan.hasMultiAdmin ? '' : 'muted' %>">Multiple admins</li>
            <li><%= plan.attachmentLimitMb >= 1024 ? (Math.round(plan.attachmentLimitMb / 1024 * 10) / 10) + 'GB' : plan.attachmentLimitMb + 'MB' %> attachments</li>
          </ul>

          <% if (plan.key === currentPlanKey) { %>
            <button type="button" class="btn ghost" disabled style="width:100%;">Current plan</button>
          <% } else if (plan.key === 'free') { %>
            <span style="font-size:12px; color:var(--text-muted); display:block; text-align:center;">Downgrade by canceling your current plan on the Billing page.</span>
          <% } else if (isAdmin) { %>
            <form method="POST" action="/billing/checkout">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="planKey" value="<%= plan.key %>">
              <input type="hidden" name="cycle" class="cycle-input" value="monthly">
              <button type="submit" class="btn" style="width:100%;">Choose <%= plan.name %></button>
            </form>
          <% } %>
        </div>
      <% }); %>
    </div>
  </div>

  <script>
    (function () {
      var buttons = document.querySelectorAll('.cycle-btn');
      var monthlyAmounts = document.querySelectorAll('.monthly-amount, .monthly-per');
      var annualAmounts = document.querySelectorAll('.annual-amount, .annual-per');
      var cycleInputs = document.querySelectorAll('.cycle-input');

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var cycle = btn.getAttribute('data-cycle');
          buttons.forEach(function (b) { b.classList.toggle('active', b === btn); });
          var showMonthly = cycle === 'monthly';
          monthlyAmounts.forEach(function (el) { el.style.display = showMonthly ? '' : 'none'; });
          annualAmounts.forEach(function (el) { el.style.display = showMonthly ? 'none' : ''; });
          cycleInputs.forEach(function (el) { el.value = cycle; });
        });
      });
    })();
  </script>
</body>
</html>
