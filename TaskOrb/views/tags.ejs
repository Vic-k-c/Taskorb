<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#17233A">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="TaskOrb">
  <title>Tags - TaskOrb</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="has-bottom-nav">
  <%- include('partials/nav', { active: 'tags', currentUser }) %>
  <div class="page">
    <h1>Tags</h1>
    <p style="font-size:13px; color:var(--text-muted); margin-top:-8px;">
      A tag applies to <strong>one board</strong> or to <strong>every board</strong>. A board-specific tag only ever appears on its own board.
      Anyone with editor access can also add a tag for a board from the board itself.
    </p>

    <div class="card-panel" style="margin-bottom:20px; max-width:640px;">
      <div class="table-scroll">
      <table class="simple">
        <thead><tr><th>Tag</th><th>Applies to</th><th></th></tr></thead>
        <tbody id="tagList">
          <% tags.forEach(function(t) { %>
            <tr data-tag-id="<%= t.id %>">
              <td><span class="tag-chip" style="background:<%= t.color %>;"><%= t.name %></span></td>
              <td style="font-size:12px;">
                <% if (t.board_id) { %><%= t.board_title %><% } else { %><span style="color:var(--text-muted);">Every board</span><% } %>
              </td>
              <td style="text-align:right; white-space:nowrap;">
                <button type="button" class="btn ghost small" data-id="<%= t.id %>" data-name="<%= t.name %>" data-color="<%= t.color %>" onclick="editTag(this)">Edit</button>
                <button type="button" class="btn danger small" onclick="deleteTag(<%= t.id %>)">Delete</button>
              </td>
            </tr>
          <% }); %>
          <% if (tags.length === 0) { %>
            <tr><td colspan="3" style="color:var(--text-muted); font-size:13px;">No tags yet. Create one below.</td></tr>
          <% } %>
        </tbody>
      </table>
      </div>
    </div>

    <div class="card-panel" style="max-width:520px;">
      <h3 id="formTitle">Create a tag</h3>
      <% if (error) { %><div class="error-box"><%= error %></div><% } %>
      <form method="POST" action="/tags" id="tagForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="tag_id" id="tagIdField">
        <label>Name</label>
        <input type="text" name="name" id="tagNameField" placeholder="e.g. Urgent, Waiting on reply" required>
        <div id="scopeWrap">
          <label>Applies to</label>
          <select name="scope" id="tagScopeField" required>
            <option value="">Choose where this tag applies&hellip;</option>
            <% if (boards.length > 0) { %>
              <optgroup label="One board only">
                <% boards.forEach(function(b) { %><option value="<%= b.id %>"><%= b.title %></option><% }); %>
              </optgroup>
            <% } %>
            <optgroup label="Every board">
              <option value="org" <%= canOrgWide ? '' : 'disabled' %>>All boards (org-wide)<%= canOrgWide ? '' : ' - paid plans' %></option>
            </optgroup>
          </select>
        </div>
        <label>Color</label>
        <input type="color" name="color" id="tagColorField" value="#3AA0E0" style="height:38px; padding:4px; cursor:pointer;">
        <button type="submit" class="btn" style="margin-top:12px;">Create tag</button>
        <button type="button" class="btn ghost" id="cancelEdit" style="display:none; margin-top:12px;" onclick="cancelEditTag()">Cancel edit</button>
      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById('tagForm');
    const scopeWrap = document.getElementById('scopeWrap');
    const scopeField = document.getElementById('tagScopeField');

    // A tag's scope is fixed once created (moving a tag between boards
    // would silently strip it from cards), so editing hides the picker.
    function editTag(btn) {
      document.getElementById('formTitle').textContent = 'Edit tag';
      document.getElementById('tagIdField').value = btn.dataset.id;
      document.getElementById('tagNameField').value = btn.dataset.name;
      document.getElementById('tagColorField').value = btn.dataset.color;
      scopeWrap.style.display = 'none';
      scopeField.required = false;
      document.getElementById('cancelEdit').style.display = 'inline-block';
      form.querySelector('button[type=submit]').textContent = 'Save changes';
      form.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    function cancelEditTag() {
      document.getElementById('formTitle').textContent = 'Create a tag';
      document.getElementById('tagIdField').value = '';
      form.reset();
      scopeWrap.style.display = '';
      scopeField.required = true;
      document.getElementById('cancelEdit').style.display = 'none';
      form.querySelector('button[type=submit]').textContent = 'Create tag';
    }

    form.addEventListener('submit', function (e) {
      const tagId = document.getElementById('tagIdField').value;
      if (!tagId) return; // plain create -- let the normal form POST /tags happen
      e.preventDefault();
      fetch(`/tags/${tagId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: document.getElementById('tagNameField').value,
          color: document.getElementById('tagColorField').value
        })
      })
        .then((r) => r.json().then((data) => ({ ok: r.ok, data })))
        .then(({ ok, data }) => { if (!ok) throw new Error(data.error); window.location.reload(); })
        .catch((err) => alert(err.message));
    });

    function deleteTag(id) {
      if (!confirm('Delete this tag? It will be removed from every card that has it.')) return;
      fetch(`/tags/${id}`, { method: 'DELETE' })
        .then((r) => r.json().then((data) => ({ ok: r.ok, data })))
        .then(({ ok, data }) => { if (!ok) throw new Error(data.error); window.location.reload(); })
        .catch((err) => alert(err.message));
    }
  </script>
</body>
</html>
