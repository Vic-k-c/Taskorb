<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Account Settings - TaskOrb</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="has-bottom-nav">
  <%- include('partials/nav', { active: 'account', currentUser }) %>
  <div class="page">
    <h1>Account settings</h1>

    <% if (error) { %><div class="error-box"><%= error %></div><% } %>
    <% if (success) { %><div class="error-box" style="background:#E7F3E9; color:#2E5B37; border-color:#BEE0C4;"><%= success %></div><% } %>

    <div class="card-panel" style="max-width:480px; margin-bottom:20px;">
      <h3>Profile</h3>
      <form method="POST" action="/account">
        <label>Full name</label>
        <input type="text" name="name" value="<%= currentUser.name %>" required>
        <label>Email</label>
        <input type="email" name="email" value="<%= currentUser.email %>" required>

        <label style="margin-top:16px;">Change password (optional)</label>
        <input type="password" name="current_password" placeholder="Current password">
        <input type="password" name="new_password" placeholder="New password (leave blank to keep current)" style="margin-top:8px;">

        <label style="margin-top:16px;">Default board template</label>
        <p style="font-size:12px; color:var(--text-muted); margin:0 0 6px;">Pre-selected whenever you create a new board.</p>
        <div class="template-picker">
          <% Object.keys(templates).forEach(function(key) { %>
            <label class="template-option <%= (currentUser.default_template || 'blank') === key ? 'selected' : '' %>">
              <input type="radio" name="default_template" value="<%= key %>" <%= (currentUser.default_template || 'blank') === key ? 'checked' : '' %>>
              <span class="t-icon"><%- templates[key].icon %></span>
              <%= templates[key].label %>
            </label>
          <% }); %>
        </div>

        <button type="submit" class="btn" style="margin-top:18px;">Save changes</button>
      </form>
    </div>

    <div class="card-panel" style="max-width:480px;">
      <h3>Your role</h3>
      <p style="font-size:13px; color:var(--text-muted);">
        You're currently a <strong style="color:var(--ink); text-transform:capitalize;"><%= currentUser.role %></strong> on this team.
        <% if (currentUser.role !== 'admin') { %>Ask an admin from the Team page if you need this changed.<% } %>
      </p>
    </div>
  </div>

  <script>
    document.querySelectorAll('.template-option').forEach(function (opt) {
      opt.addEventListener('click', function () {
        document.querySelectorAll('.template-option').forEach((o) => o.classList.remove('selected'));
        opt.classList.add('selected');
      });
    });
  </script>
</body>
</html>
