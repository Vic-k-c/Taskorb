<div class="topnav">
  <div class="brand-wrap">
    <a href="/" class="brand"><img src="/img/logo.png" alt="TaskOrb" class="logo-img"></a>
    <% if (currentUser && typeof currentOrg !== 'undefined' && currentOrg) { %>
      <div class="org-switch-wrap" id="orgSwitchWrap">
        <button class="org-switch-btn" id="orgSwitchBtn" type="button">
          <%= currentOrg.name %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="org-switch-dropdown" id="orgSwitchDropdown">
          <% userOrgs.forEach(function(o) { %>
            <% if (o.id === currentOrg.id) { %>
              <div class="org-switch-item current"><%= o.name %> <span class="tag"><%= o.role %></span></div>
            <% } else { %>
              <button type="button" class="org-switch-item" onclick="switchOrg(<%= o.id %>)"><%= o.name %></button>
            <% } %>
          <% }); %>
          <a class="org-switch-item new" href="/orgs">+ New / switch organization</a>
        </div>
      </div>
    <% } %>
  </div>
  <nav>
    <a href="/" class="<%= active === 'dashboard' ? 'active' : '' %>">Dashboard</a>
    <a href="/map" class="<%= active === 'map' ? 'active' : '' %>">Map</a>
    <a href="/boards" class="<%= active === 'boards' ? 'active' : '' %>">Boards</a>
    <% if (currentUser && typeof currentOrg !== 'undefined' && currentOrg && currentOrg.role === 'admin') { %>
      <a href="/users" class="<%= active === 'users' ? 'active' : '' %>">Team</a>
    <% } %>
  </nav>
  <div class="userbox">
    <% if (currentUser) { %>
      <div class="notif-wrap" id="notifWrap">
        <button class="notif-bell" id="notifBell" type="button" aria-label="Notifications">
          &#128276;
          <span class="notif-badge" id="notifBadge">0</span>
        </button>
        <div class="notif-dropdown" id="notifDropdown">
          <div class="notif-dropdown-header">Notifications</div>
          <div id="notifList"><div class="notif-empty">Loading&hellip;</div></div>
        </div>
      </div>
      <% if (currentUser.is_platform_admin) { %>
        <a href="/platform" class="account-link <%= active === 'platform' ? 'active' : '' %>" title="Platform admin" aria-label="Platform admin">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5l7.5 3.4v5.6c0 4.9-3.2 8.7-7.5 9.9-4.3-1.2-7.5-5-7.5-9.9V5.9L12 2.5z"/></svg>
        </a>
      <% } %>
      <a href="/account" class="account-link <%= active === 'account' ? 'active' : '' %>" title="Account settings" aria-label="Account settings">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.6"/><path d="M4.5 20c0-4 3.4-6.8 7.5-6.8s7.5 2.8 7.5 6.8"/></svg>
      </a>
      <span class="username"><%= currentUser.name %></span>
      <% if (typeof currentOrg !== 'undefined' && currentOrg) { %><span class="role-pill"><%= currentOrg.role %></span><% } %>
      <a href="/logout">Log out</a>
    <% } %>
  </div>
</div>

<% if (currentUser) { %>
<div class="bottom-tabbar">
  <div class="tabs">
    <a href="/" class="<%= active === 'dashboard' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
      Dashboard
    </a>
    <a href="/map" class="<%= active === 'map' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6.5-6.1-6.5-11a6.5 6.5 0 0113 0c0 4.9-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/></svg>
      Map
    </a>
    <a href="/boards" class="<%= active === 'boards' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16M15 4v16"/></svg>
      Boards
    </a>
    <% if (typeof currentOrg !== 'undefined' && currentOrg && currentOrg.role === 'admin') { %>
      <a href="/users" class="<%= active === 'users' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><circle cx="17.5" cy="9" r="2.4"/><path d="M15.7 14.2c2.6.4 4.3 2.3 4.3 5.3"/></svg>
        Team
      </a>
    <% } %>
  </div>
</div>
<script>window.CSRF_TOKEN = <%- JSON.stringify(csrfToken) %>;</script>
<script src="/js/csrf.js"></script>
<script src="/js/notifications.js"></script>
<script>
  (function () {
    const btn = document.getElementById('orgSwitchBtn');
    const dropdown = document.getElementById('orgSwitchDropdown');
    if (!btn) return;
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      dropdown.classList.toggle('open');
    });
    document.addEventListener('click', function (e) {
      if (!dropdown.contains(e.target) && e.target !== btn) dropdown.classList.remove('open');
    });
    window.switchOrg = function (orgId) {
      fetch(`/orgs/switch/${orgId}`, { method: 'POST' })
        .then((r) => r.json().then((data) => ({ ok: r.ok, data })))
        .then(({ ok, data }) => { if (!ok) throw new Error(data.error); window.location.href = '/'; })
        .catch((err) => alert(err.message));
    };
  })();
</script>
<% } %>
