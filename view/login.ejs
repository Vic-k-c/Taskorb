<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Log in - TaskOrb</title>
  <link rel="icon" href="/img/logo.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-box">
      <img src="/img/logo.png" alt="TaskOrb" class="logo-img" style="height:36px; margin-bottom:8px;">
      <p class="sub">Map-enabled boards for any kind of outreach or workflow</p>
      <% if (error) { %><div class="error-box"><%= error %></div><% } %>
      <form method="POST" action="/login">
        <label>Email</label>
        <input type="email" name="email" required autofocus>
        <label>Password</label>
        <input type="password" name="password" required>
        <button class="btn" type="submit">Log in</button>
      </form>
      <div class="switch">First time here? <a href="/register">Set up your account</a></div>
    </div>
  </div>
</body>
</html>
